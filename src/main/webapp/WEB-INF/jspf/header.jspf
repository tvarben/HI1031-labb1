<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="jakarta.tags.core" prefix="c" %>
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${not empty requestScope.title
    ? requestScope.title
    : param.title}" default="Webshop"/></title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body>
<header class="site-header">
    <h1>Min Webshop</h1>
    <nav>
        <a href="${pageContext.request.contextPath}/index.jsp">Hem</a>
        <a href="${pageContext.request.contextPath}/cart">Varukorg (${sessionScope.cart.itemCount != null ? sessionScope.cart.itemCount : 0})</a>

        <c:if test="${empty sessionScope.loggedInUser}">
            <a href="${pageContext.request.contextPath}/login">Logga in</a>
        </c:if>
        <c:if test="${sessionScope.loggedInUser.role == 'admin'}">
            <a href="${pageContext.request.contextPath}/admin/users">
                Användaradministration
            </a>
        </c:if>
        <c:if test="${not empty sessionScope.loggedInUser}">
            <span>Inloggad som ${sessionScope.loggedInUser.username}!</span>
            <a href="${pageContext.request.contextPath}/logout">Logga ut</a>
        </c:if>
    </nav>
</header>
<main>